# כתובת האתר הציבורית (ל־sitemap, canonical, שיתופים)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- יצירת קשר וקביעת תאריכים ---
# מספר וואטסאפ בפורמט בינלאומי ללא + (למשל 972501234567) — טופס "קביעת תאריך" נפתח בצ'אט
NEXT_PUBLIC_WHATSAPP_NUMBER=
# טלפון ואימייל לתצוגה בפוטר ובעמוד צור קשר (אופציונלי — אם ריק, לא מוצג)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- פניות מהאתר: טלגרם + מייל לדוד (טופס + מספר שהושאר בצ'אט). מספיק ערוץ אחד כדי שהפנייה תיחשב נמסרה ---
# טוקן מ-BotFather, ומזהה הצ'אט של דוד מול הבוט. בלי אף ערוץ, הטופס נופל לוואטסאפ/טלפון.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# מייל לכל פנייה (Resend, דומיין dmorgen.com מאומת). הכתובת של דוד רק ב-Vercel, לא בקוד: הריפו ציבורי.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# אופציונלי, ברירת מחדל: פניות מהאתר <leads@dmorgen.com>
LEAD_EMAIL_FROM=
# אופציונלי: כל פנייה נשלחת גם כ-JSON לכתובת הזו (CRM, Google Sheets, Make, n8n)
LEAD_WEBHOOK_URL=

# --- אזור לקוחות: הטמעת bchira.app ---
NEXT_PUBLIC_BCHIRA_URL=https://bchira.app/

